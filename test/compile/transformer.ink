# test/data/transformer_train.ink's transformer, its weights
# those 1500 steps of an exploration reached on batches of four, rounded to
# thousandths: in NumPy they reverse every one of its 512 held-out
# sequences, each logit chosen at least 3.1 above the next. 'unseen' reads
# four of them, one a step, its logits within 1e-14 of the interpreter's:
#
#     unseen: 4 steps from 0, against exact values until 0 and inexact ones from there
#     unseen.Z: within <e>; the interpreter's terms about <e> from the exact ones
nv = 8
nt = 6
nd = 8
mu(x)[b,t] = sum_(j=1)^nd x[b,t,j]/nd
cen(x, m)[b,t,j] = x[b,t,j] - m[b,t]
rs(z)[b,t] = 1/(sum_(j=1)^nd z[b,t,j]^2/nd + 1/100000)^(1/2)
lnc(z, r, g, c)[b,t,j] = g[1,j]*z[b,t,j]*r[b,t] + c[1,j]
lns(z, g, c) = lnc(z, rs(z), g, c)
lnorm(x, g, c) = lns(cen(x, mu(x)), g, c)
ex(z)[b,t,s] = exp(z[b,t,s])
den(e)[b,t] = sum_(r=1)^nt e[b,t,r]
nrm(e, d)[b,t,s] = e[b,t,s]/d[b,t]
sm(e) = nrm(e, den(e))
head(a, Q, K, Vv, k) = sm(ex((a*Q[k])*(a*K[k])'/2))*(a*Vv[k])
att(a, Q, K, Vv, O, l) = sum_(h=1)^2 head(a, Q, K, Vv, 2*l-2+h)*O[2*l-2+h]
relu(z)[b,t,f] | z[b,t,f] > 0 = z[b,t,f]
relu(z)[b,t,f] = 0
addr(z, r)[b,t,f] = z[b,t,f] + r[1,f]
ff(a, W1, c1, W2, c2, l) = addr(relu(addr(a*W1[l], c1[l]))*W2[l], c2[l])
res1(x, Q, K, Vv, O, G, Bb, l) = x + att(lnorm(x, G[2*l-1], Bb[2*l-1]), Q, K, Vv, O, l)
res2(x, W1, c1, W2, c2, G, Bb, l) = x + ff(lnorm(x, G[2*l], Bb[2*l]), W1, c1, W2, c2, l)
blk(x, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, l) = res2(res1(x, Q, K, Vv, O, G, Bb, l), W1, c1, W2, c2, G, Bb, l)
fwd(X, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U) = lnorm(blk(blk(X*E + P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, 1), Q, K, Vv, O, W1, c1, W2, c2, G, Bb, 2), G[5], Bb[5])*U
tE = [0.766 1.25 0.368 -1.016 -0.876 -0.166 -0.271 -1.535; -0.157 0.372 -0.124 -0.678 -0.055 0.004 -1.268 0.842; 0.562 2.437 0.686 0.426 1.083 -0.069 0.317 -0.698; 0.906 0.95 0.61 -0.737 -0.985 0.591 0.197 0.692; -0.143 1.399 -0.173 0.173 0.897 -1.239 -0.734 -0.048; 2.031 -0.156 0.316 0.843 0.301 -1.098 0.462 -0.813; 0.498 -1.098 -0.244 1.016 0.872 -1.014 -0.931 -0.116; 0.923 -0.293 0.192 -0.598 -0.02 1.135 -0.337 -0.962]
tP = [-0.814 0.312 -1.856 0.605 -1.291 0.117 0.037 -0.284; 2.051 0.055 1.038 -0.312 -0.184 0.284 -2.832 0.038; -0.533 -1.271 1.246 -0.439 -2.455 -0.339 -1.156 -0.396; -0.507 1.021 0.169 -0.471 0.598 -1.65 1.53 -0.776; 0.395 -0.432 -1.129 -0.626 1.99 0.546 -0.69 -0.406; -0.835 0.366 -1.196 0.784 -1.911 -0.015 -0.972 -0.509]
tQ = [0.211 0.036 0.174 0.239; 0.371 -0.479 0.191 -0.496; -0.072 0.519 -0.158 -0.134; 0.129 0.004 0.079 -0.098; 0.287 0.341 -0.114 -0.007; 0.204 0.279 0.079 0.158; -0.035 -0.255 -0.121 0.318; 0.441 0.084 -0.141 0.244;; 0.768 0.503 -0.248 -0.041; -0.434 -0.325 0.088 0.118; 0.517 0.219 0.445 0.451; -0.505 -0.318 -0.026 0.93; 0.056 0.079 0.256 0.291; -0.858 0.243 -0.261 0.572; 0.252 -0.066 0.74 -0.029; 0.161 0.454 -0.436 0.692;; 0.789 -0.638 -0.038 0.086; 0.035 0.061 0.258 -0.811; -0.154 -0.314 0.838 -0.547; -0.785 -0.406 -0.277 -0.04; 0.52 0.567 0.564 0.034; 0.558 0.279 -0.391 0.42; -0.493 0.903 -0.257 -0.158; -0.464 0.282 0.453 0.298;; -0.067 0.265 -0.274 -0.574; 0.183 -0.031 0.127 -0.358; -1.046 -0.249 -0.076 0.223; -0.099 0.561 0.471 0.118; 0.442 -0.412 0.468 -0.497; -0.107 0.206 0.196 -0.053; 0.685 -0.365 0.159 0.432; 0.004 0.022 0.738 0.2]
tK = [0.144 -0.36 -0.26 0.387; 0.098 -0.523 -0.213 0.021; 0.225 0.258 0.382 -0.213; 0.409 -0.33 -0.085 0.368; 0.057 0.073 -0.059 -0.176; 0.533 0.304 0.197 0.202; 0.27 0.152 0.155 0.189; 0.077 0.406 0.61 0.34;; -0.487 0.631 0.244 -0.109; -0.332 0.193 0.412 0.232; 0.568 0.179 0.591 -0.42; -0.638 -0.2 -0.124 0.439; 0.958 -0.098 -0.097 0; -0.19 0.157 0.232 0.051; -0.089 -0.492 0.122 0.451; -0.113 0.296 0.339 0.107;; 0.838 0.164 -0.41 -0.088; 0.176 -0.079 -0.207 0.557; -0.151 1.181 0.077 -0.078; -0.365 0.44 -0.79 0.043; 0.595 0.023 0.742 0.009; -0.334 -0.29 -0.039 -0.087; -0.905 0.17 -0.004 -0.204; 0.472 0.262 -0.249 -0.399;; 0.177 -0.027 0.227 -1.047; 0.103 0.005 0.192 -0.028; 0.767 -0.625 0.356 -0.098; 0.334 0.026 -0.357 0.512; -0.177 -0.884 -0.057 -0.202; 0.232 0.066 0.015 -0.055; -0.287 -0.372 0.163 0.454; 0.201 -0.39 -0.54 -0.123]
tVv = [0.251 -0.423 -0.314 0.145; -0.098 -0.003 -0.129 -0.256; -0.135 0.042 -0.06 0.144; 0.13 0.007 0.092 -0.397; -0.446 0.306 0.029 -0.089; -0.21 -0.153 -0.164 -0.089; -0.303 -0.291 0.005 0.523; -0.179 0.068 -0.37 0.119;; 0.514 -0.601 0.078 0.659; 0.102 0.023 -0.598 -0.315; 0.307 0.42 0.315 -0.187; -0.169 -0.405 -0.573 0.435; 0.175 -0.162 0.329 -0.686; 0.396 -0.141 0.177 0.123; -0.009 0.174 -0.148 0.122; -0.327 -0.432 -0.222 0.338;; 0.631 0.36 0.459 -0.005; -0.047 -1.382 0.179 -0.079; 0.241 0.297 0.105 -0.517; 0.097 -0.512 -1.199 0.469; -0.003 -0.539 -0.203 0.095; 0.347 0.758 0.82 0.525; 0.143 0.413 0.174 -0.714; -0.21 0.477 0.188 1.613;; 0.421 -0.032 0.155 0.349; -1.09 -0.124 0.153 -0.302; -0.213 0.183 -0.141 0.758; 0.641 0.846 -0.096 -0.365; 0.655 0.163 -0.607 -0.495; 0.146 -0.757 -0.45 0.485; 0.16 0.147 0.534 0.111; -0.686 -0.221 0.173 -1.192]
tO = [0.184 0.249 -0.307 -0.213 -0.313 0.042 0.12 0.062; -0.339 0.003 0.018 0.223 0.116 -0.426 -0.456 -0.047; -0.225 0.055 0.393 -0.014 -0.499 -0.368 0.077 -0.322; 0.407 0.009 0.124 -0.092 -0.013 -1.045 -0.268 0.156;; -0.372 -0.247 -0.219 -0.197 0.02 0.173 -0.407 0.403; -0.642 -0.308 0.004 0.012 -0.269 0.038 -0.396 -0.384; -0.345 -0.13 -0.18 -0.371 0.877 -0.355 -0.032 -0.506; 0.543 -0.125 -0.178 -0.259 -0.342 -0.963 -0.046 0.048;; 0.281 -0.341 -0.211 -0.036 -0.648 -0.098 -0.204 0.265; -0.098 -0.159 -1.435 0.86 0.087 -0.721 -0.634 0.017; -0.097 0.095 -0.181 0.22 0.564 0.82 -0.352 -0.235; -1.131 -0.233 0.601 0.68 0.071 -0.8 0.065 0.471;; 0.291 0.49 0.024 0.39 -0.091 -0.624 0.618 1.282; 0.155 -0.602 0.759 -0.187 -0.41 -0.523 -0.393 0.517; 0.282 -0.149 -0.109 -0.132 0.437 0.044 0.281 -0.624; 0.54 -0.039 -0.659 -0.153 -0.134 0.816 -0.481 0.365]
tW1 = [0.173 0.233 -0.237 -0.434 -0.267 0.228 -0.033 0.24; -0.108 0.178 -0.72 -0.129 0.254 -0.279 -0.273 -0.408; 0.618 -0.239 -0.366 0.196 0.527 0.677 0.277 0.219; -0.047 0.075 0.079 0.322 -0.332 0.051 -0.207 -0.218; -0.047 -0.281 -0.614 -0.521 0.52 -0.211 -0.043 -0.654; -0.067 0.142 -0.411 -0.432 -0.572 0.245 -0.165 0.068; -0.204 0.419 0.237 0.615 0.772 0.05 0.373 -0.221; 0.079 -0.62 0.148 0.107 -0.113 -0.027 0.301 0.016;; 0.037 -0.053 -0.364 -0.443 -0.046 -0.464 -0.262 -0.207; -0.584 -0.732 -0.226 -0.23 0.851 0.127 -0.171 -0.197; -0.336 -0.116 0.068 0.182 -0.251 0.287 0.298 0.626; -0.515 0.154 -0.32 -0.528 -0.004 -0.491 -0.034 0.903; 0.552 0.714 0.639 -0.81 -0.389 -0.03 0.183 -0.464; -0.688 0.737 0.524 0.257 -0.257 0.186 -0.466 0.498; 0.088 0.041 -0.199 -0.126 0.185 -0.124 0.323 -0.026; -0.146 -0.355 0.261 0.416 0.188 -0.8 -0.167 0.434]
tc1 = [0.008 -0.11 -0.17 0.009 0.013 0.121 -0.194 0.154;; 0.02 -0.019 0.163 0.103 0.181 -0.053 0.029 -0.01]
tW2 = [-0.077 0.146 -0.245 0.332 0.176 -0.781 -0.092 0.224; -0.283 -0.614 0.4 -0.029 0.306 -0.092 -0.274 -0.528; 0.113 -0.218 0.254 0.092 -0.059 0.283 -0.238 0.074; 0.497 0.144 -0.079 -0.34 0.305 0.461 -0.347 0.204; -0.485 -0.57 0.243 0.338 0.134 0.904 0.809 0.733; -0.79 -0.174 0.698 -0.255 0.254 -0.575 0.456 -0.013; 0.29 0.275 -1.014 -0.577 0.12 -0.426 0.041 -0.354; -0.019 -0.456 0.313 0.243 0.307 0.167 0.13 0.163;; -0.245 -0.318 0.257 -0.075 -0.507 0.418 0.079 -0.12; -0.071 -0.024 0.209 0.321 -0.349 -0.314 0.133 -0.29; 0.424 -0.333 0.416 0.606 0.185 -0.083 0.503 -0.63; 0.009 0.765 -0.545 -0.703 0.365 -0.305 -0.115 -0.424; 0.518 -0.331 -0.12 -0.587 0.24 0.003 0.098 0.824; -0.128 -0.453 -0.227 0.155 0.429 -0.321 -0.092 -0.154; -0.145 -0.255 0.22 0.328 -0.05 0.066 0.166 0.351; 0.396 -0.328 0.416 -0.531 -0.301 0.078 -0.44 0.022]
tc2 = [-0.143 -0.09 -0.301 -0.016 -0.248 0.238 0.371 0.19;; -0.05 -0.015 0.056 -0.111 -0.014 0.123 0.062 -0.05]
tG = [0.854 0.596 1.205 0.716 0.721 0.873 0.663 0.568;; 0.885 0.811 0.992 0.84 0.913 0.55 1.15 0.868;; 1.308 1.418 1.427 1.771 1.508 1.481 1.284 1.817;; 0.839 1.022 0.937 0.899 1.407 1.153 1.007 1.062;; 2.206 0.256 2.655 2.411 1.223 2.013 1.387 2.137]
tBb = [-0.157 -0.02 0.078 -0.199 0.006 0.091 0.179 0.023;; 0.012 -0.086 0.084 0.005 0.09 0.08 -0.057 0.102;; -0.164 -0.072 -0.095 -0.051 0.257 0.04 0.161 -0.16;; -0.098 0.076 -0.063 -0.106 0.012 0.01 0 0.173;; -0.199 -0.059 -0.133 0.048 -0.006 0.037 0.035 -0.117]
tU = [0.619 -1.514 0.216 -0.094 -0.844 1.279 -0.556 0.005; -0.547 -0.152 0.249 0.155 0.419 -0.174 -0.312 -0.054; -0.951 0.733 0.585 -0.683 1.604 -0.393 0.698 -1.616; -0.577 0.877 -1.516 1.295 -0.645 -0.56 -0.025 0.286; -0.212 0.403 -0.116 0.968 -0.084 0.003 -0.432 0.027; 1.049 -0.407 0.464 -0.02 -0.248 -0.768 -1.332 0.081; -0.621 0.277 0.187 -0.216 0.634 0.293 0.553 -0.689; -0.627 -0.42 -0.92 -0.85 -0.482 1.012 0.987 0.68]
Te = [7 7 4 3 4 4; 3 2 5 7 2 8; 4 7 4 6 7 4; 3 8 3 6 2 2]
inf(E = tE, P = tP, Q = tQ, K = tK, Vv = tVv, O = tO, W1 = tW1, c1 = tc1, W2 = tW2, c2 = tc2, G = tG, Bb = tBb, U = tU, X_n[b<=1, t<=nt, v<=nv]) = {
    Z_n = fwd(X_n, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U)
}
oh(k)[b<=1, t<=nt, v<=nv] = Te[k+1, t] == v
unseen = inf(X_n = oh(n))

# 'tune', U trained beneath those weights by grad of the cross-entropy of a
# reversal, a step's sequence the one 'unseen' reads and its target that
# sequence reversed. U_0 is exact and every later U reads exp's and log's
# doubles, so its terms are within unseen's 1e-14 of the interpreter's:
#
#     tuned: 4 steps from 0, against exact values until 1 and inexact ones from there
#     tuned.U: within <e>; the interpreter's terms about <e> from the exact ones
#
# Its step is one function of 451,298 bytes, the forward pass and the sweep
# back to U; GCC 13 builds its check program at -O2 in 26 s. Split into
# functions (DESIGN.md, a compiled step split into functions), as unseen's of
# 272,495 bytes: 'inkamath --compile transformer.ink tune -o tune.h' and its
# 'inf -o inf.h' write no function of 32,768 bytes or more, the init's
# weights among them.
lse(z)[b,t] = log(sum_(v=1)^nv exp(z[b,t,v]))
ce(z[b<=p, t<=q, v<=w], y) = sum_(b=1)^p sum_(t=1)^q (lse(z)[b,t] - sum_(v=1)^w y[b,t,v]*z[b,t,v])/(p*q)
tune(eta = 1/10, E = tE, P = tP, Q = tQ, K = tK, Vv = tVv, O = tO, W1 = tW1, c1 = tc1, W2 = tW2, c2 = tc2, G = tG, Bb = tBb, X_n[b<=1, t<=nt, v<=nv], Y_n[b<=1, t<=nt, v<=nv]) = {
    U_0 = tU
    U_n = U_(n-1) - eta*grad_(A = U_(n-1)) ce(fwd(X_n, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, A), Y_n)
}
rv(k)[b<=1, t<=nt, v<=nv] = Te[k+1, nt+1-t] == v
tuned = tune(X_n = oh(n), Y_n = rv(n))
