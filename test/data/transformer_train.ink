# A transformer (Vaswani et al. 2017, pre-layer-norm) of two blocks of two
# heads, width 8, over eight tokens in sequences of six, trained to reverse
# them by one grad of its thirteen weights, read as g.W_n: an exploration's
# training, cut to three steps on batches of two of its first six sequences.
# The start is Gaussian draws rounded to thousandths. J_n, batch n's loss
# after step n, is NumPy's, by a tape of the backward pass and again by
# central differences of every weight, within 3e-11. Written by hand, never
# recorded.
>> nv = 8
nv = 8

>> nt = 6
nt = 6

>> nd = 8
nd = 8

>> mu(x)[b,t] = sum_(j=1)^nd x[b,t,j]/nd
mu(x)[b,t] = sum_(j=1)^nd x[b,t,j]/nd

>> cen(x, m)[b,t,j] = x[b,t,j] - m[b,t]
cen(x, m)[b,t,j] = x[b,t,j] - m[b,t]

>> rs(z)[b,t] = 1/(sum_(j=1)^nd z[b,t,j]^2/nd + 1/100000)^(1/2)
rs(z)[b,t] = 1/(sum_(j=1)^nd z[b,t,j]^2/nd + 1/100000)^(1/2)

>> lnc(z, r, g, c)[b,t,j] = g[1,j]*z[b,t,j]*r[b,t] + c[1,j]
lnc(z, r, g, c)[b,t,j] = g[1,j]*z[b,t,j]*r[b,t] + c[1,j]

>> lns(z, g, c) = lnc(z, rs(z), g, c)
lns(z, g, c) = lnc(z, rs(z), g, c)

>> lnorm(x, g, c) = lns(cen(x, mu(x)), g, c)
lnorm(x, g, c) = lns(cen(x, mu(x)), g, c)

>> ex(z)[b,t,s] = exp(z[b,t,s])
ex(z)[b,t,s] = exp(z[b,t,s])

>> den(e)[b,t] = sum_(r=1)^nt e[b,t,r]
den(e)[b,t] = sum_(r=1)^nt e[b,t,r]

>> nrm(e, d)[b,t,s] = e[b,t,s]/d[b,t]
nrm(e, d)[b,t,s] = e[b,t,s]/d[b,t]

>> sm(e) = nrm(e, den(e))
sm(e) = nrm(e, den(e))

>> head(a, Q, K, Vv, k) = sm(ex((a*Q[k])*(a*K[k])'/2))*(a*Vv[k])
head(a, Q, K, Vv, k) = sm(ex((a*Q[k])*(a*K[k])'/2))*(a*Vv[k])

>> att(a, Q, K, Vv, O, l) = sum_(h=1)^2 head(a, Q, K, Vv, 2*l-2+h)*O[2*l-2+h]
att(a, Q, K, Vv, O, l) = sum_(h=1)^2 head(a, Q, K, Vv, 2*l-2+h)*O[2*l-2+h]

>> relu(z)[b,t,f] | z[b,t,f] > 0 = z[b,t,f]
relu(z)[b,t,f] | z[b,t,f] > 0 = z[b,t,f]

>> relu(z)[b,t,f] = 0
relu(z)[b,t,f] = 0

>> addr(z, r)[b,t,f] = z[b,t,f] + r[1,f]
addr(z, r)[b,t,f] = z[b,t,f] + r[1,f]

>> ff(a, W1, c1, W2, c2, l) = addr(relu(addr(a*W1[l], c1[l]))*W2[l], c2[l])
ff(a, W1, c1, W2, c2, l) = addr(relu(addr(a*W1[l], c1[l]))*W2[l], c2[l])

>> res1(x, Q, K, Vv, O, G, Bb, l) = x + att(lnorm(x, G[2*l-1], Bb[2*l-1]), Q, K, Vv, O, l)
res1(x, Q, K, Vv, O, G, Bb, l) = x + att(lnorm(x, G[2*l-1], Bb[2*l-1]), Q, K, Vv, O, l)

>> res2(x, W1, c1, W2, c2, G, Bb, l) = x + ff(lnorm(x, G[2*l], Bb[2*l]), W1, c1, W2, c2, l)
res2(x, W1, c1, W2, c2, G, Bb, l) = x + ff(lnorm(x, G[2*l], Bb[2*l]), W1, c1, W2, c2, l)

>> blk(x, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, l) = res2(res1(x, Q, K, Vv, O, G, Bb, l), W1, c1, W2, c2, G, Bb, l)
blk(x, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, l) = res2(res1(x, Q, K, Vv, O, G, Bb, l), W1, c1, W2, c2, G, Bb, l)

>> fwd(X, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U) = lnorm(blk(blk(X*E + P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, 1), Q, K, Vv, O, W1, c1, W2, c2, G, Bb, 2), G[5], Bb[5])*U
fwd(X, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U) = lnorm(blk(blk(X*E + P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, 1), Q, K, Vv, O, W1, c1, W2, c2, G, Bb, 2), G[5], Bb[5])*U

>> lse(z)[b,t] = log(sum_(v=1)^nv exp(z[b,t,v]))
lse(z)[b,t] = log(sum_(v=1)^nv exp(z[b,t,v]))

>> ce(z[b<=p, t<=q, v<=w], y) = sum_(b=1)^p sum_(t=1)^q (lse(z)[b,t] - sum_(v=1)^w y[b,t,v]*z[b,t,v])/(p*q)
ce(z[b<=p, t<=q, v<=w], y) = sum_(b=1)^p sum_(t=1)^q (lse(z)[b,t] - sum_(v=1)^w y[b,t,v]*z[b,t,v])/(p*q)

>> loss(X, Y, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U) = ce(fwd(X, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U), Y)
loss(X, Y, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U) = ce(fwd(X, E, P, Q, K, Vv, O, W1, c1, W2, c2, G, Bb, U), Y)

>> oh(S, k, m)[b<=m, t<=nt, v<=nv] = S[k+b, t] == v
oh(S, k, m)[b<=m, t<=nt, v<=nv] = S[k+b, t] == v

>> rv(S, k, m)[b<=m, t<=nt, v<=nv] = S[k+b, nt+1-t] == v
rv(S, k, m)[b<=m, t<=nt, v<=nv] = S[k+b, nt+1-t] == v

